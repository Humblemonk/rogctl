{
  "permissions": {
    "ask": [
      "Bash(sudo *)",
      "Bash(cargo install *)",
      "Bash(cargo +*)",
      "Bash(rustup *)",
      "Bash(rogctl configure*)",
      "Bash(*/rogctl configure*)",
      "Bash(cargo run*-- configure*)",
      "Bash(noctalia msg plugins *)",
      "Bash(kpackagetool6 *)",
      "Bash(gnome-extensions *)",
      "Bash(scripts/aur-release.fish*)",
      "Bash(./scripts/aur-release.fish*)",
      "Bash(fish *aur-release.fish*)",
      "Edit(~/.config/noctalia/**)",
      "Edit(~/.local/state/noctalia/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_mouse_writes.py",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
