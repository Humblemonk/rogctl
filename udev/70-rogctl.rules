# Let the logged-in user talk to supported ASUS mice over hidraw (for rogctl).
# One line per USB product ID in src/models.rs; `cargo test` checks they match.
# ASUS Mouse MD200: receiver
KERNEL=="hidraw*", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1a24", TAG+="uaccess"
# Gladius II Wireless: receiver
KERNEL=="hidraw*", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="18a0", TAG+="uaccess"
