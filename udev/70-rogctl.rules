# Let the logged-in user talk to supported ASUS mice and keyboards over hidraw
# (for rogctl).
# Only the one USB interface rogctl uses on each (the "inNN" at the end of the
# interface's modalias, which also holds the vendor and product IDs): the
# others can carry keystrokes and pointer input, which rogctl never reads. udev
# needs every ATTRS key to match on one parent device, and only the interface's
# modalias holds all three.
# One line per USB product ID in src/models.rs, with its interface; `cargo test`
# checks they match.
# ASUS Mouse MD200: receiver
KERNEL=="hidraw*", ATTRS{modalias}=="usb:v0B05p1A24*in02", TAG+="uaccess"
# Gladius II Wireless: receiver
KERNEL=="hidraw*", ATTRS{modalias}=="usb:v0B05p18A0*in02", TAG+="uaccess"
# Harpe Ace Mini: cable
KERNEL=="hidraw*", ATTRS{modalias}=="usb:v0B05p1B63*in00", TAG+="uaccess"
# Omni receiver (paired mice and keyboards listed in src/models.rs)
KERNEL=="hidraw*", ATTRS{modalias}=="usb:v0B05p1ACE*in02", TAG+="uaccess"
# ROG Chakram: cable
KERNEL=="hidraw*", ATTRS{modalias}=="usb:v0B05p18E3*in00", TAG+="uaccess"
