{
  "custom/rog-mouse": {
    "exec": "rogctl watch --format waybar --device mouse --interval 60 --low-threshold 20",
    "return-type": "json",
    "restart-interval": 10,
    "format": "{icon} {text}",
    "hide-empty-text": true,
    "format-icons": {
      "connected": "󰍽",
      "charging": "󰂄",
      "asleep": "󰍽",
      "error": "󰍾",
      "disconnected": "󰍾"
    }
  },
  "custom/rog-keyboard": {
    "exec": "rogctl watch --format waybar --device keyboard --interval 60 --low-threshold 20",
    "return-type": "json",
    "restart-interval": 10,
    "format": "{icon} {text}",
    "hide-empty-text": true,
    "format-icons": {
      "connected": "󰌌",
      "charging": "󰂄",
      "asleep": "󰌌",
      "error": "󰌐",
      "disconnected": "󰌐"
    }
  }
}
